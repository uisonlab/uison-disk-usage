// Parts of the Disk Usage screen. The code (lib.rs) prepares the data: rows hold already formatted numbers and colors,
// `t.*` holds the texts in the interface language (i18n.rs).
{
  // Folder and file icons on a 24×24 grid, like the library's Icon: outlines, and the filled open folder of the buttons.
  Glyph: {
    params: { name: "file", size: 15, color: "$theme.text" },
    body: {
      Vector: {
        view: 24, w: "$size", h: "$size", color: "$color", weight: 1.6,
        children: {
          switch: "$name",
          cases: {
            // Filled, like the original's 🗁: the back with its tab, and the front flap slanted open.
            // The flap is two triangles; a stroke of the same color covers the antialiasing seam between them.
            folderOpen: [
              { Rect: { at: [2, 4], w: 7, h: 4, radius: 1, fill: "$color" } },
              { Rect: { at: [2, 6], w: 16, h: 3, fill: "$color" } },
              { Rect: { at: [2, 6], w: 2.2, h: 14, fill: "$color" } },
              { Tri: { points: [6.8, 11.3, 22.2, 11.3, 18.2, 19.7], fill: "$color", stroke: "$color", width: 0.6 } },
              { Tri: { points: [6.8, 11.3, 18.2, 19.7, 2.3, 19.7], fill: "$color", stroke: "$color", width: 0.6 } },
            ],
            // The original's ⟳: an open circle as short lines (round caps hide the joints), the arrowhead at the top.
            refresh: [
              { Line: { from: [15.7, 6.1], to: [13.2, 5.1], width: 2.2 } },
              { Line: { from: [13.2, 5.1], to: [10.5, 5.2], width: 2.2 } },
              { Line: { from: [10.5, 5.2], to: [8.1, 6.2], width: 2.2 } },
              { Line: { from: [8.1, 6.2], to: [6.2, 8.1], width: 2.2 } },
              { Line: { from: [6.2, 8.1], to: [5.2, 10.5], width: 2.2 } },
              { Line: { from: [5.2, 10.5], to: [5.1, 13.2], width: 2.2 } },
              { Line: { from: [5.1, 13.2], to: [6.1, 15.7], width: 2.2 } },
              { Line: { from: [6.1, 15.7], to: [7.9, 17.7], width: 2.2 } },
              { Line: { from: [7.9, 17.7], to: [10.3, 18.8], width: 2.2 } },
              { Line: { from: [10.3, 18.8], to: [13, 18.9], width: 2.2 } },
              { Line: { from: [13, 18.9], to: [15.5, 18.1], width: 2.2 } },
              { Line: { from: [15.5, 18.1], to: [17.5, 16.3], width: 2.2 } },
              { Tri: { points: [19.2, 9.3, 18.5, 3.8, 13.7, 8.6], fill: "$color", stroke: "$color", width: 0.4 } },
            ],
            // The original's 🗑, filled: lid with its handle, and the can whose slots are gaps between bars
            // (the button shows through them in any state).
            trash: [
              { Rect: { at: [9.5, 2.8], w: 5, h: 3, radius: 1, fill: "$color" } },
              { Rect: { at: [4, 5], w: 16, h: 2.2, radius: 0.8, fill: "$color" } },
              { Rect: { at: [5.5, 8.2], w: 13, h: 2, fill: "$color" } },
              { Rect: { at: [5.5, 8.2], w: 3.2, h: 12, fill: "$color" } },
              { Rect: { at: [10.4, 8.2], w: 3.2, h: 12, fill: "$color" } },
              { Rect: { at: [15.3, 8.2], w: 3.2, h: 12, fill: "$color" } },
              { Rect: { at: [5.5, 18], w: 13, h: 3, radius: 1.2, fill: "$color" } },
            ],
            folder: [
              { Line: { from: [3, 6], to: [3, 19] } },
              { Line: { from: [3, 19], to: [21, 19] } },
              { Line: { from: [21, 19], to: [21, 9] } },
              { Line: { from: [21, 9], to: [11.5, 9] } },
              { Line: { from: [11.5, 9], to: [9.5, 6] } },
              { Line: { from: [9.5, 6], to: [3, 6] } },
            ],
          },
          default: [
            { Line: { from: [6, 3], to: [6, 21] } },
            { Line: { from: [6, 21], to: [18, 21] } },
            { Line: { from: [18, 21], to: [18, 8] } },
            { Line: { from: [18, 8], to: [13, 3] } },
            { Line: { from: [13, 3], to: [6, 3] } },
            { Line: { from: [13, 3], to: [13, 8] } },
            { Line: { from: [13, 8], to: [18, 8] } },
          ],
        },
      },
    },
  },

  // A Button with a Glyph before the text (the library Button takes only library icons):
  // variant secondary | primary | danger, size sm | lg — as in Button.
  GlyphButton: {
    params: {
      glyph: "folderOpen", text: "", variant: "secondary", size: "sm",
      fg: {
        switch: "$variant",
        cases: { primary: "$theme.onPrimary", danger: "$theme.onPrimary" },
        default: { state: { normal: "$theme.text", disabled: "$theme.muted" } },
      },
    },
    interactive: true,
    body: {
      Box: {
        padding: { switch: "$size", cases: { lg: [11, 22] }, default: [4, 10] },
        radius: { switch: "$size", cases: { lg: "$theme.radius" }, default: "$theme.radiusSm" },
        align: "center",
        fill: {
          switch: "$variant",
          cases: {
            primary: { state: { normal: "$theme.primary", hover: "$theme.primaryHover", pressed: "$theme.primaryPressed", disabled: "$theme.primaryDisabled" } },
            danger: { state: { normal: "$theme.danger", hover: "$theme.dangerHover", pressed: "$theme.dangerPressed", disabled: "$theme.primaryDisabled" } },
          },
          default: { state: { normal: "$theme.surface", hover: "$theme.surfaceHover", pressed: "$theme.surfacePressed" } },
        },
        stroke: { switch: "$variant", cases: { secondary: "$theme.border" } },
        child: { Row: { gap: { switch: "$size", cases: { lg: 8 }, default: 6 }, cross: "center", children: [
          { Glyph: { name: "$glyph", size: { switch: "$size", cases: { lg: 19 }, default: 14 }, color: "$fg" } },
          { Text: { text: "$text", bold: true, size: { switch: "$size", cases: { lg: 15 }, default: 12 }, color: "$fg" } },
        ] } },
      },
    },
  },

  Toolbar: {
    body: {
      Box: {
        padding: [8, 10], fill: "$theme.card",
        child: { Row: { w: "fill", gap: 8, cross: "center", children: [
          { GlyphButton: { key: "open", text: "@t.open", on: { click: "open" }, tooltip: "@t.openTip", visible: "!@console" } },
          { GlyphButton: { key: "rescan", glyph: "refresh", text: "@t.rescan", disabled: "!@canRescan", on: { click: "rescan" }, tooltip: "@t.rescanTip" } },
          { IconButton: { key: "up", icon: "arrowUp", size: "sm", disabled: "!@canUp", on: { click: "up" }, tooltip: "@t.upTip" } },
          { Box: { w: 1, h: 20, fill: "$theme.divider", visible: "@crumbs" } },
          {
            Box: { flex: 1, clip: true, align: "left", child: { Row: {
              gap: 2, cross: "center",
              children: {
                For: {
                  each: "@crumbs", as: "c",
                  do: {
                    Row: {
                      gap: 2, cross: "center",
                      children: [
                        { Text: { text: "›", color: "$theme.muted", visible: "@c.sep" } },
                        {
                          Box: {
                            key: "crumb-{@c.id}", padding: [3, 5], radius: 4, on: { click: "crumb" },
                            fill: { state: { normal: null, hover: "$theme.surfaceHover", pressed: "$theme.surfacePressed" } },
                            child: { Text: { text: "@c.name", bold: "@c.last" } },
                          },
                        },
                      ],
                    },
                  },
                },
              },
            } } },
          },
          { LangSwitch: {} },
          { IconButton: { key: "info", icon: "info", size: "sm", on: { click: "about" }, tooltip: "@t.about" } },
        ] } },
      },
    },
  },

  // Interface language: two options in one plate, as tall as the small buttons; a click runs "lang".
  LangSwitch: {
    body: {
      Box: {
        padding: 2, radius: "$theme.radiusSm", fill: "$theme.surface", stroke: "$theme.border",
        child: { Row: { gap: 2, children: [{ LangOption: { code: "en", label: "EN" } }, { LangOption: { code: "ru", label: "RU" } }] } },
      },
    },
  },

  LangOption: {
    params: { code: "", label: "" },
    body: {
      Box: {
        key: "lang-{$code}", padding: [2, 8], radius: 4, on: { click: "lang" },
        fill: { switch: { eq: ["@lang", "$code"] }, cases: { true: "$theme.surfacePressed" }, default: { state: { normal: null, hover: "$theme.surfaceHover" } } },
        child: {
          Text: {
            text: "$label", size: 12, bold: { eq: ["@lang", "$code"] },
            color: { switch: { eq: ["@lang", "$code"] }, cases: { true: "$theme.text" }, default: "$theme.muted" },
          },
        },
      },
    },
  },

  StatusBar: {
    body: {
      Box: {
        padding: [6, 12], fill: "$theme.card",
        child: { Row: { w: "fill", gap: 12, cross: "center", children: [
          { Text: { text: "@message", size: 12, visible: "@message", maxLines: 1 } },
          { Text: { text: "@status", size: 12, color: "$theme.muted", maxLines: 1, flex: 1 } },
          { Text: { text: "@t.hints", size: 12, color: "$theme.muted", visible: "@status" } },
        ] } },
      },
    },
  },

  StartScreen: {
    body: {
      Column: {
        padding: [24, 20, 64, 20], gap: 6, main: "center", cross: "center",
        children: [
          { Text: { text: "Disk Usage", size: 32, bold: true } },
          { Text: { text: "@t.tagline", color: "$theme.muted" } },
          { Text: { text: "@message", color: "$theme.warning", visible: "@message", margin: [12, 0, 0, 0] } },
          { GlyphButton: { key: "choose", text: "@t.choose", variant: "primary", size: "lg", minW: 220, margin: [24, 0, 10, 0], on: { click: "open" }, visible: "!@console" } },
          { Text: { text: "@t.orScan", color: "$theme.muted", margin: [0, 0, 4, 0] } },
          {
            For: {
              each: "@quick", as: "q",
              do: { Button: { key: "quick-{@q.i}", text: "@q.path", variant: "secondary", minW: 220, on: { click: "quick" } } },
            },
          },
        ],
      },
    },
  },

  ScanScreen: {
    body: {
      Column: {
        padding: [24, 24, 64, 24], gap: 6, main: "center", cross: "center",
        children: [
          { Canvas: { key: "spinner", draw: "spinner", w: 80, h: 80, margin: [0, 0, 18, 0] } },
          { Text: { text: "@scan.title", size: 20 } },
          // The counts change twice a second: monospace keeps their width, so the centered line doesn't jitter.
          { Text: { text: "@scan.counts", size: 15, font: "monospace" } },
          { Text: { text: "@scan.current", size: 14, color: "$theme.muted", maxLines: 1, w: 600, margin: [4, 0, 0, 0] } },
          { Text: { text: "@scan.stall", color: "$theme.warning", visible: "@scan.stall", maxW: 640, align: "center" } },
          { Button: { key: "cancel", text: "@t.cancel", variant: "secondary", size: "lg", minW: 160, margin: [16, 0, 0, 0], on: { click: "cancel" } } },
        ],
      },
    },
  },

  ViewScreen: {
    body: {
      Row: {
        cross: "stretch",
        children: [
          { DetailsPanel: { w: "@layout.details" } },
          { Splitter: { key: "splitDetails", path: "@layout.details", min: 260, max: 600, delta: 1 } },
          {
            Canvas: {
              key: "chart", draw: "chart", flex: 1, h: "fill", cursor: "arrow",
              on: { click: "chartClick", hover: "chartHover" }, contextMenu: "@menu",
            },
          },
          { Splitter: { key: "splitQueue", path: "@layout.queue", min: 240, max: 520, delta: -1, visible: "@queue.count" } },
          { QueuePanel: { w: "@layout.queue", visible: "@queue.count" } },
        ],
      },
    },
  },

  // A divider between panels: dragging sets the panel width at `path` (`delta: -1` — the panel is to the right),
  // a double click brings back the default (lib.rs). The 6 pt grip is wider than its 1 pt line.
  Splitter: {
    params: { path: "", min: 0, max: 0, delta: 1 },
    body: {
      Box: {
        w: 6, h: "fill", align: "center", cursor: "resize-x",
        drag: { path: "$path", min: "$min", max: "$max", delta: "$delta" }, on: { click: "resetWidth" },
        child: { Box: { w: 1, h: "fill", fill: { state: { normal: "$theme.divider", hover: "$theme.border", pressed: "$theme.muted" } } } },
      },
    },
  },

  DetailsPanel: {
    body: {
      Column: {
        padding: [12, 10, 4, 12], gap: 6, cross: "stretch",
        children: [
          {
            Row: {
              gap: 8, cross: "center",
              children: [
                { Box: { w: 14, h: 14, radius: 3, fill: "@sel.color" } },
                { Text: { text: "@sel.name", size: 18, bold: true, flex: 1 } },
              ],
            },
          },
          {
            Wrap: {
              gap: 8, cross: "center",
              children: [
                { Text: { text: "@sel.size", size: 22, bold: true } },
                { Text: { text: "@sel.facts", size: 14, color: "$theme.muted" } },
              ],
            },
          },
          { Text: { text: "@sel.path", size: 13, color: "$theme.muted" } },
          {
            Row: {
              gap: 6, margin: [4, 0, 0, 0],
              children: [
                { Button: { key: "zoomSel", text: "@t.zoomIn", variant: "secondary", size: "sm", visible: "@sel.canZoom", on: { click: "zoomSel" } } },
                { Button: { key: "revealSel", text: "@t.reveal", variant: "secondary", size: "sm", on: { click: "revealSel" }, tooltip: "@t.showIn" } },
                {
                  Button: {
                    key: "queueSel", text: "@t.trash", variant: "secondary", size: "sm", visible: "@sel.canQueue", disabled: "@sel.covered",
                    on: { click: "queueSel" }, tooltip: "@sel.queueTip",
                  },
                },
                { Button: { key: "unqueueSel", text: "@t.unqueue", variant: "secondary", size: "sm", visible: "@sel.queued", on: { click: "unqueueSel" } } },
              ],
            },
          },
          { Box: { h: 1, fill: "$theme.divider", margin: [6, 0, 2, 0] } },
          { Text: { text: "@emptyText", color: "$theme.muted", visible: "@emptyText" } },
          {
            List: {
              key: "rows", items: "@rows", as: "r", itemHeight: 24, flex: 1,
              item: {
                Stack: {
                  key: "row-{@r.id}", on: { click: "row", hover: "rowHover" }, contextMenu: "@menu", cursor: "arrow",
                  children: [
                    { Box: { w: "fill", h: "fill", radius: 4, fill: { state: { normal: "@r.bg", hover: "$theme.card" } } } },
                    // Size bar behind the text, relative to the largest sibling.
                    { Box: { pos: [0, 3], w: "@r.frac", h: 18, radius: 3, fill: "@r.tint" } },
                    { Box: { pos: [0, 3], w: 4, h: 18, radius: 2, fill: "@r.color" } },
                    {
                      Row: {
                        w: "fill", h: "fill", padding: [0, 8, 0, 12], gap: 7, cross: "center",
                        children: [
                          { Glyph: { name: "@r.icon", color: "@r.fg" } },
                          { Text: { text: "@r.name", size: 14, color: "@r.fg", maxLines: 1, flex: 1 } },
                          { Text: { text: "@r.size", size: 14, align: "right", w: 70 } },
                          { Text: { text: "@r.pct", size: 14, color: "$theme.muted", align: "right", w: 46 } },
                        ],
                      },
                    },
                  ],
                },
              },
            },
          },
        ],
      },
    },
  },

  QueuePanel: {
    body: {
      Column: {
        padding: [12, 12, 4, 10], gap: 6, cross: "stretch",
        children: [
          { Text: { text: "@t.queueTitle", size: 18, bold: true } },
          {
            Row: {
              gap: 8, cross: "center",
              children: [
                { Text: { text: "@queue.size", size: 22, bold: true } },
                { Text: { text: "@queue.label", size: 14, color: "$theme.muted" } },
              ],
            },
          },
          {
            Row: {
              gap: 6, margin: [4, 0, 0, 0],
              children: [
                { GlyphButton: { key: "trashAll", glyph: "trash", text: "@t.trashAll", variant: "danger", on: { click: "trashQueued" }, tooltip: "@t.trashAllTip" } },
                { Button: { key: "clearQueue", text: "@t.clearQueue", variant: "secondary", size: "sm", on: { click: "clearQueue" }, tooltip: "@t.clearQueueTip" } },
              ],
            },
          },
          { Box: { h: 1, fill: "$theme.divider", margin: [6, 0, 2, 0] } },
          {
            Scroll: {
              key: "queueScroll", flex: 1,
              child: {
                Column: {
                  gap: 2, cross: "stretch",
                  children: {
                    For: {
                      each: "@queue.items", as: "q",
                      do: {
                        Box: {
                          key: "q-{@q.id}", padding: [4, 6], radius: 4, on: { click: "locate", hover: "queueHover" }, contextMenu: "@menu",
                          cursor: "arrow", fill: { state: { normal: "@q.bg", hover: "$theme.card" } },
                          child: {
                            Column: {
                              gap: 2, cross: "stretch",
                              children: [
                                {
                                  Row: {
                                    gap: 7, cross: "center",
                                    children: [
                                      { Glyph: { name: "@q.icon" } },
                                      { Text: { text: "@q.name", size: 14, maxLines: 1, flex: 1 } },
                                      { Text: { text: "@q.size", size: 14 } },
                                      { IconButton: { key: "unq-{@q.id}", icon: "close", size: "sm", on: { click: "unqueue" }, tooltip: "@t.unqueueTip" } },
                                    ],
                                  },
                                },
                                { Text: { text: "@q.folder", size: 13, color: "$theme.muted" } },
                              ],
                            },
                          },
                        },
                      },
                    },
                  },
                },
              },
            },
          },
        ],
      },
    },
  },

  AboutDialog: {
    body: {
      Box: {
        w: 360, padding: 20, radius: 10, fill: "$theme.card", stroke: "$theme.border",
        child: {
          Column: {
            gap: 6, cross: "center",
            children: [
              { Text: { text: "Disk Usage", size: 22, bold: true } },
              { Text: { text: "@t.version", size: 13, color: "$theme.muted" } },
              { Text: { text: "@t.aboutLine", color: "$theme.muted" } },
              { Text: { text: "@t.aboutText", align: "center", margin: [8, 0, 0, 0] } },
              // A link Text rather than the library Link: that one is as wide as the column and starts at its left.
              {
                Text: {
                  text: "github.com/MarketKernel/disk-usage", href: "https://github.com/MarketKernel/disk-usage", margin: [8, 0, 0, 0],
                  color: { state: { normal: "$theme.primary", hover: "$theme.primaryHover", pressed: "$theme.primaryPressed" } },
                  decoration: { state: { normal: "none", hover: "underline", pressed: "underline" } },
                },
              },
              { Button: { key: "closeAbout", text: "@t.close", variant: "secondary", margin: [10, 0, 0, 0], on: { click: "closeAbout" } } },
            ],
          },
        },
      },
    },
  },
}
